# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/coreclip?retryWrites=true&w=majority
# For local development, you can use:
# MONGODB_URI=mongodb://localhost:27017/coreclip

# Server Port
PORT=5000

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_webhook_signing_secret_here

# Cloudinary for Image/Video Storage
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Google GenAI (for image and video generation)
GOOGLE_CLOUD_API_KEY=your_google_genai_api_key_here

# Optional: Client URL for CORS (production)
CLIENT_URL=https://yourdomain.com
